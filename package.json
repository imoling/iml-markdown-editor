{
  "name": "iml-markdown-editor",
  "version": "26.5.1",
  "description": "极简而极致的 Markdown 编辑器，支持双模编辑、PDF 导出与智能目录同步。",
  "main": "dist-electron/main.js",
  "scripts": {
    "test": "vitest run",
    "predev": "node scripts/build-syscap.mjs && npx tsc -p electron/tsconfig.json",
    "dev": "concurrently \"vite\" \"npx tsc -p electron/tsconfig.json -w\" \"(wait-on tcp:5173 || wait-on tcp:5174) && cross-env NODE_ENV=development ELECTRON_RUN_AS_NODE= electron .\"",
    "build": "tsc && vite build && tsc -p electron/tsconfig.json && electron-builder",
    "build:mac": "tsc && vite build && tsc -p electron/tsconfig.json && node scripts/build-syscap.mjs && electron-builder --mac",
    "build:win": "tsc && vite build && tsc -p electron/tsconfig.json && electron-builder --win",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "tiptap",
    "minimalist",
    "productivity"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@replit/codemirror-vim": "^6.4.0",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-bubble-menu": "^2.11.5",
    "@tiptap/extension-code-block-lowlight": "^2.11.5",
    "@tiptap/extension-floating-menu": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text-align": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/suggestion": "^2.27.2",
    "@types/katex": "^0.16.8",
    "@types/marked": "^5.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@uiw/react-codemirror": "^4.25.8",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.15",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "katex": "^0.16.38",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "marked": "^15.0.0",
    "mermaid": "^11.13.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.0",
    "wait-on": "^9.0.4",
    "zustand": "^5.0.11"
  },
  "build": {
    "appId": "com.imoling.markdown-editor",
    "productName": "iML Markdown Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.test.js",
      "assets/logo.png",
      "assets/icon-mac.png"
    ],
    "protocols": [
      {
        "name": "iML Markdown Editor",
        "schemes": [
          "iml"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "mimeType": "text/markdown",
        "role": "Editor",
        "icon": "assets/logo.icns"
      }
    ],
    "mac": {
      "icon": "assets/logo.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Markdown Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "net.daringfireball.markdown",
              "public.plain-text"
            ],
            "CFBundleTypeExtensions": [
              "md",
              "markdown",
              "mdown",
              "mkd"
            ],
            "CFBundleTypeMIMETypes": [
              "text/markdown",
              "text/plain"
            ]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "net.daringfireball.markdown",
            "UTTypeDescription": "Markdown Document",
            "UTTypeConformsTo": [
              "public.plain-text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "md",
                "markdown",
                "mdown",
                "mkd"
              ],
              "public.mime-type": "text/markdown"
            }
          }
        ],
        "NSMicrophoneUsageDescription": "实时转写需要使用麦克风。声音只在这台电脑上识别成文字；录音（可以关掉）也只存在本机，不会上传。"
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "build/bin/syscap",
          "to": "bin/syscap"
        }
      ]
    },
    "win": {
      "icon": "assets/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/logo.ico",
      "uninstallerIcon": "assets/logo.ico",
      "installerHeaderIcon": "assets/logo.ico",
      "installerSidebar": "assets/installerSidebar.png",
      "installerHeader": "assets/installerHeader.png",
      "createDesktopShortcut": "always",
      "shortcutName": "iML Markdown Editor",
      "allowElevation": true,
      "runAfterFinish": true,
      "buildUniversalInstaller": false,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "electronLanguages": [
      "en",
      "en-US",
      "zh_CN",
      "zh-CN",
      "zh_TW",
      "zh-TW"
    ],
    "compression": "maximum"
  }
}
